# 星期天AI（Weekly Day AI）OpenAI-compatible gateway
WEEKLY_DAY_AI_BASE_URL=https://your-gateway.example.com/v1
WEEKLY_DAY_AI_API_KEY=
WEEKLY_DAY_AI_MODEL=
WEEKLY_DAY_AI_TEMPERATURE=0.4
WEEKLY_DAY_AI_MAX_TOKENS=5000
WEEKLY_DAY_AI_REQUEST_TIMEOUT_MS=90000
WEEKLY_DAY_AI_REQUEST_RETRIES=2
WEEKLY_DAY_AI_WEBSITE_URL=https://www.weekly-day.top/

# Hacker News selection
HN_FETCH_LIMIT=50
# Optional comma-separated AI topic keywords; defaults to the built-in AI keyword list
HN_AI_KEYWORDS=
HN_MIN_SCORE=50
HN_MIN_COMMENTS=10
HN_FETCH_CONCURRENCY=8
HN_REQUEST_TIMEOUT_MS=12000
HN_REQUEST_RETRIES=3
DAILY_ARTICLE_COUNT=2

# Publishing
PUBLISH_TIMEZONE=Asia/Shanghai

# View counter Worker (workers/view-counter; set after deploying the Worker)
PUBLIC_VIEWS_API_URL=

# Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT_NAME=ai-daily
