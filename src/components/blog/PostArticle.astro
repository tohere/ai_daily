---
import type { Locale, Post } from '../../data/posts';
import { encodePathSegment, formatDate, getPostHeadings } from '../../utils/blog';

interface Props { post: Post; locale: Locale; }
const { post, locale } = Astro.props;
const basePath = locale === 'zh' ? '/zh' : '/en';
const headings = getPostHeadings(post, locale);
let headingIndex = 0;
const weeklyDayAiUrl = 'https://www.weekly-day.top/';
---

<article class="post-article">
  <header class="post-article__header">
    <a class="post-article__back" href={basePath + '/'}>← {locale === 'zh' ? '返回首页' : 'Back home'}</a>
    <p class="post-article__eyebrow">{post.category[locale]}</p>
    <h1 class="post-article__title">{post.title[locale]}</h1>
    <div class="post-article__meta">
      <time datetime={post.date}>{formatDate(post.date, locale)}</time>
      <span>{locale === 'zh' ? '阅读 · ' : ''}{post.readingTime}{locale === 'zh' ? ' 分钟' : ' min read'}</span>
      <span class="post-article__views" data-views-page hidden>
        <svg class="post-article__views-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
        <span data-views-value></span>{locale === 'zh' ? ' 次浏览' : ' views'}
      </span>
      {post.isGenerated && <span class="post-article__generated-badge"><strong>{locale === 'zh' ? 'AI 生成' : 'AI generated'}</strong></span>}
    </div>
    {post.disclosure && (
      <p class="post-article__disclosure">
        {locale === 'zh' ? <>本文使用</> : <>This article was <strong>automatically generated</strong> by the </>}
        <a class="ai-provider-link" href={weeklyDayAiUrl} target="_blank" rel="noopener noreferrer"><strong>{locale === 'zh' ? '星期天AI' : 'Weekly Day AI'}</strong></a>
        {locale === 'zh'
          ? <>中转站大模型，基于 Hacker News 内容<strong>自动生成</strong>。</>
          : ' gateway model using content from Hacker News.'}
      </p>
    )}
    {post.source && (
      <nav class="post-article__sources" aria-label={locale === 'zh' ? '文章来源' : 'Article sources'}>
        <a href={post.source.originalUrl} target="_blank" rel="noopener noreferrer">
          {locale === 'zh' ? '阅读原文 ↗' : 'Read original ↗'}
        </a>
        <a href={post.source.hnUrl} target="_blank" rel="noopener noreferrer">
          {locale === 'zh' ? 'Hacker News 讨论 ↗' : 'Hacker News discussion ↗'}
        </a>
      </nav>
    )}
  </header>

  <div class="post-article__body">
    {post.content[locale].map((block) => {
      if (block.type === 'heading') {
        const heading = headings[headingIndex++];
        return heading
          ? <h2 id={heading.id}>{block.text[locale]}</h2>
          : <h2>{block.text[locale]}</h2>;
      }
      if (block.type === 'quote') return <blockquote>{block.text[locale]}</blockquote>;
      if (block.type === 'code') return <figure class="code-block"><figcaption>{block.language}</figcaption><pre tabindex="0"><code translate="no">{block.code}</code></pre></figure>;
      return <p>{block.text[locale]}</p>;
    })}
  </div>

  <footer class="post-article__footer">
    <div class="post-preview__tags">{post.tags[locale].map((tag) => <a class="post-tag" href={`${basePath}/tags/${encodePathSegment(tag)}/`}>{tag}</a>)}</div>
    <a class="post-article__back post-article__back--footer" href={basePath + '/archives/'}>{locale === 'zh' ? '浏览更多文章 →' : 'Browse more posts →'}</a>
  </footer>
</article>

<script>
  // 阅读计数：进入详情页时 +1（同 IP 同文章同天只计一次，由 Worker 去重）
  const api = import.meta.env.PUBLIC_VIEWS_API_URL;
  const el = document.querySelector('[data-views-page]');
  if (api && el) {
    fetch(`${api}/api/views`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: location.pathname }),
    })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data || !Number.isFinite(data.views)) return;
        el.querySelector('[data-views-value]').textContent = data.views;
        el.hidden = false;
      })
      .catch(() => {});
  }
</script>
