---
import BlogLayout from '../../layouts/BlogLayout.astro';
import HomePreview from '../../components/home/HomePreview.astro';
import { locales } from '../../utils/blog';
import { sortPosts, } from '../../utils/blog';
import { allPosts } from '../../data';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

const { locale } = Astro.props;
---
<BlogLayout locale={locale}><HomePreview locale={locale} posts={sortPosts(allPosts).slice(0, 3)} /></BlogLayout>
