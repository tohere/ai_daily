---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/blog/PostList.astro';
import { allPosts } from '../../data';
import { locales, sortPosts } from '../../utils/blog';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

const { locale } = Astro.props;
const isZh = locale === 'zh';
---
<BlogLayout locale={locale} title={isZh ? '文章归档 · AI Daily' : 'Archives · AI Daily'}>
  <section class="page-intro" aria-labelledby="archives-title">
    <p class="section-eyebrow">Archive</p>
    <h1 id="archives-title" class="page-intro__title">{isZh ? '文章归档' : 'Archives'}</h1>
    <p class="page-intro__description">{isZh ? '按时间回看这里留下的想法与实验。' : 'A timeline of notes, experiments, and ideas left here over time.'}</p>
  </section>
  <PostList posts={sortPosts(allPosts)} locale={locale} />
</BlogLayout>
