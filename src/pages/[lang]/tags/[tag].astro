---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostList from '../../../components/blog/PostList.astro';
import { allPosts } from '../../../data';
import { collectTags, locales, sortPosts } from '../../../utils/blog';

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const used = new Set<string>();
    return collectTags(locale)
      // 参数保持原文（Astro 自行编码），仅替换会把路由拆成多段的斜杠（如 AI 生成的标签 "A/I"）
      .map((tag) => ({ segment: tag.name.replace(/[/\\]/g, '-'), props: { locale, tag: tag.name } }))
      .filter(({ segment }) => !used.has(segment) && used.add(segment))
      .map(({ segment, props }) => ({ params: { lang: locale, tag: segment }, props }));
  });
}

const { locale, tag } = Astro.props;
const isZh = locale === 'zh';
const posts = sortPosts(allPosts.filter((post) => post.tags[locale].includes(tag)));
---
<BlogLayout locale={locale} title={`#${tag} · AI Daily`}>
  <section class="page-intro" aria-labelledby="tag-title">
    <p class="section-eyebrow">Tag</p>
    <h1 id="tag-title" class="page-intro__title"># {tag}</h1>
    <p class="page-intro__description">{isZh ? `共 ${posts.length} 篇文章。` : `${posts.length} ${posts.length === 1 ? 'post' : 'posts'} with this tag.`}</p>
  </section>
  <PostList posts={posts} locale={locale} />
</BlogLayout>
