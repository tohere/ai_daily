{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weekly-day-ai.local/schemas/generated-post.schema.json",
  "title": "AI Daily generated Hacker News post",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "generation",
    "post"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hnId",
        "hnUrl",
        "originalUrl",
        "title",
        "author",
        "score",
        "commentCount",
        "publishedAt",
        "fetchedAt"
      ],
      "properties": {
        "hnId": {
          "type": "integer",
          "minimum": 1
        },
        "hnUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://news\\.ycombinator\\.com/item\\?id="
        },
        "originalUrl": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "commentCount": {
          "type": "integer",
          "minimum": 0
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "generatedAt"
      ],
      "properties": {
        "provider": {
          "const": "Weekly Day AI"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "date",
        "publishedAt",
        "readingTime",
        "category",
        "tags",
        "title",
        "excerpt",
        "disclosure",
        "content"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "readingTime": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "category": {
          "$ref": "#/$defs/localizedString"
        },
        "tags": {
          "$ref": "#/$defs/localizedStringArray"
        },
        "title": {
          "$ref": "#/$defs/localizedString"
        },
        "excerpt": {
          "$ref": "#/$defs/localizedString"
        },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh",
            "en"
          ],
          "properties": {
            "zh": {
              "const": "本文使用星期天AI中转站大模型，基于 Hacker News 内容自动生成。"
            },
            "en": {
              "const": "This article was automatically generated by the Weekly Day AI gateway model using content from Hacker News."
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh",
            "en"
          ],
          "properties": {
            "zh": {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/postBlock"
              }
            },
            "en": {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/postBlock"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localizedString": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localizedStringArray": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "en": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "localizedBlockText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "postBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "heading"
            },
            "text": {
              "$ref": "#/$defs/localizedBlockText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "text": {
              "$ref": "#/$defs/localizedBlockText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "quote"
            },
            "text": {
              "$ref": "#/$defs/localizedBlockText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "language",
            "code"
          ],
          "properties": {
            "type": {
              "const": "code"
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
